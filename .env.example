# Copy to .env.local and fill in. Server-only: never prefix these with NEXT_PUBLIC_.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxx

# Inbox that receives the contact form messages.
# With onboarding@resend.dev as sender, Resend only delivers to the account owner's email.
CONTACT_TO_EMAIL=equipo@ejemplo.com

# Sender shown in the email. Use a verified domain in production.
CONTACT_FROM_EMAIL="Arcade Vault <onboarding@resend.dev>"
